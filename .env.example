# Supabase
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anonima-aqui

# NOTA: A Service Role Key NÃO deve ser exposta no frontend.
# Ela é configurada automaticamente nas Edge Functions do Supabase.
# Não use VITE_SUPABASE_SERVICE_ROLE_KEY — isso exporia a chave no bundle.

ADMIN_EMAIL=admin@exemplo.com
ADMIN_PASSWORD=sua-senha-aqui
